# Copy this file to .env and fill in real values. DO NOT commit your .env with secrets.
# MongoDB connection string (replace <password> and <cluster> and <dbname>)
MONGODB_URI=mongodb+srv://gameUser:<password>@cluster0.xxxxx.mongodb.net/tictactoe?retryWrites=true&w=majority

# Secret used for signing JWTs (change to a strong, random value)
JWT_SECRET=your_jwt_secret_here

# Port the server should listen on
PORT=3000
