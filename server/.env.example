# Node environment
NODE_ENV=development

# Server port
PORT=3000

# MongoDB connection string
# For local: mongodb://localhost:27017/tictactoe
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/tictactoe
MONGODB_URI=mongodb://localhost:27017/tictactoe

# JWT Secret (use a long random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# CORS origin (comma-separated for multiple origins)
# Development: http://localhost:19000,exp://192.168.1.x:8081
# Production: https://your-app-domain.com
CORS_ORIGIN=http://localhost:19000

# Game timeouts (in seconds)
MATCH_TIMEOUT_SECONDS=30
TURN_TIMEOUT_SECONDS=30
RECONNECT_TIMEOUT_SECONDS=30

# ELO rating system
INITIAL_ELO=1000
ELO_K_FACTOR=32
